# ============================================================
# 环境变量示例文件
# 用法：复制为 .env 后按需修改
# 注意：.env 里不要提交到版本库（已在 .gitignore 中排除）
# ============================================================

# ---------- 应用 ----------
APP_NAME=财税知识引擎
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---------- PostgreSQL（业务真相源） ----------
POSTGRES_USER=cs_user
POSTGRES_PASSWORD=cs_password
POSTGRES_DB=customer_service
POSTGRES_PORT=5432
# 应用连接串（容器内使用服务名 postgres；本机调试用 localhost）
DATABASE_URL=postgresql+psycopg://cs_user:cs_password@postgres:5432/customer_service

# ---------- Qdrant（可重建向量索引） ----------
QDRANT_URL=http://qdrant:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------- Redis（会话与缓存） ----------
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ---------- 对象存储（原始文件与快照，S3 兼容） ----------
# 本地用 SeaweedFS；云端可换成阿里云 OSS / 腾讯云 COS，只改 ENDPOINT 与密钥
# 注意：S3_ACCESS_KEY / S3_SECRET_KEY 必须与 deploy/seaweedfs/s3.json 里的一致
S3_ACCESS_KEY=cs_s3
S3_SECRET_KEY=cs_s3_password
S3_BUCKET=customer-service
S3_ENDPOINT=http://seaweedfs:8333
# 宿主机自检用地址（scripts/check_object_storage.py 读这个）
S3_HOST_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_PORT=9000
S3_FILER_PORT=8888

# ---------- Embedding 服务 ----------
# stub         = 占位哈希实现，不加载模型、秒级启动，只用于联调（检索质量是假的）
# bge_m3       = 真实 bge-m3，输出 1024 维稠密 + 稀疏向量
#
# 用 bge_m3 的两个前提：
#   1. 模型文件放在 deploy/models/bge-m3/（见该目录下的下载说明），容器内挂载为 /models
#   2. 构建 embedding 镜像时加 --build-arg INSTALL_HEAVY=true
# 换后端之后必须重建向量索引：两种向量不通用，混在同一个集合里检索结果会乱。
EMBEDDING_BACKEND=stub
# bge_m3 时指向容器内的模型目录；stub 时这一行不起作用
EMBEDDING_MODEL=/models/bge-m3
EMBEDDING_URL=http://embedding:8001
EMBEDDING_PORT=8001
DENSE_DIM=1024
# 半精度：留空=自动（有 CUDA 显卡才开）。CPU 上必须为 0，否则更慢甚至报错
EMBEDDING_USE_FP16=
# 单次向量化请求的超时秒数。CPU 跑一批 64 条条文可能要几十秒，别设太小
EMBEDDING_TIMEOUT_SECONDS=300
# 把模型输入截断到多少 token。本库最长条文 620 字，1024 足够且能挡住超长输入
EMBEDDING_MAX_LENGTH=1024
# 离线模式：1 = 只用本地模型文件（推荐，国内访问 huggingface.co 会超时）
# 改成 0 会让容器尝试联网下载模型，除非你能稳定访问外网，否则不要改
HF_HUB_OFFLINE=1

# ---------- 域包（可插拔的领域包） ----------
# 容器内固定为 /app/domains；本机调试用仓库根的 domains/
DOMAINS_ROOT=/app/domains
# true = 域包加载失败则服务拒绝启动（开发期推荐，能立刻发现 manifest 写错）
# false = 跳过并继续启动（生产期推荐，单个域坏掉不该拖垮全站）
DOMAIN_PACK_STRICT=true

# ---------- LLM（阶段 5 起使用） ----------
# 留空则相关功能不可用，不影响阶段 0～4
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 备用供应商（主供应商不可用时切换）
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# ---------- 安全 ----------
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# ---------- 固定管理员（唯一超级账号） ----------
# 该账号拥有全部权限，且不可被删除、停用或降权；只用于初始化与兜底
# 初始口令留空时，首次启动会生成随机口令并打印到日志；首次登录强制改密码
BOOTSTRAP_ADMIN_USERNAME=root_admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- 功能开关 ----------
# 筹划功能上线开关：资质主体（F2）落实前保持 false
FEATURE_PLANNING_ENABLED=false
